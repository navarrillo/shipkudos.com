#!/usr/bin/env bash
set -Eeuo pipefail
[[ $# == 1 && $1 =~ ^[0-9a-f]{40}$ ]] || { echo 'Usage: bin/deploy <40-character-commit-sha>' >&2; exit 2; }
target=$1
source "$(dirname -- "$0")/common"
previous_image=$(state get current image 2>/dev/null || true)
previous_sha=$(state get current sha 2>/dev/null || true)
export APP_SHA=$target APP_IMAGE="$IMAGE_REPO:$target"
docker pull "$APP_IMAGE"
digest=$(docker image inspect "$APP_IMAGE" --format '{{index .RepoDigests 0}}')
[[ "$digest" == "$IMAGE_REPO@sha256:"* ]] || { echo 'Unexpected image digest' >&2; exit 1; }
export APP_IMAGE=$digest
if ! dc ps --status running --services | grep -qx postgres; then dc up -d --no-deps postgres; fi
for attempt in $(seq 1 30); do
  if dc exec -T postgres pg_isready -U "${POSTGRES_USER:-shipkudos}" -d "${POSTGRES_DB:-shipkudos}" >/dev/null; then break; fi
  (( attempt < 30 )) || { echo 'PostgreSQL did not become ready' >&2; exit 1; }
  sleep 2
done
printf '%s\n' "$target" > "$STATE_DIR/pending-release"
# Exactly one migration entrypoint. Application processes never migrate on startup.
dc run --rm -T --no-deps migrate
recover() {
  trap - ERR INT TERM
  echo 'New release failed; recovering application images only' >&2
  if [[ -n "$previous_image" ]]; then
    activate "$previous_image" "$previous_sha" && check_ready "$previous_sha" || echo 'Previous release also failed readiness; inspect service logs' >&2
  else
    dc stop web worker || true
    echo 'First release has no rollback image; PostgreSQL and volumes retained' >&2
  fi
  exit 1
}
trap recover ERR INT TERM
activate "$APP_IMAGE" "$target"
check_ready "$target"
state commit "$target" "$APP_IMAGE"
rm -f "$STATE_DIR/pending-release"
trap - ERR INT TERM
echo "Release $target is ready"
