# Store the real file outside the checkout: /etc/shipkudos/.env (chmod 600).
# One-line Docker/Bash-compatible values; quote values containing spaces.
NODE_ENV=production
APP_NAME=ShipKudos
APP_URL=https://shipkudos.com
PORT=8020
APP_SHA=development
IMAGE_REPO=ghcr.io/navarrillo/shipkudos.com
COMPOSE_PROJECT_NAME=shipkudos
STATE_DIR=/var/lib/shipkudos/deploy
UPLOADS_DIR=/var/lib/shipkudos/uploads
BACKUP_DIR=/var/backups/shipkudos
POSTGRES_USER=shipkudos
POSTGRES_DB=shipkudos
POSTGRES_PASSWORD=
# URL-encode the password component; keep this consistent with POSTGRES_PASSWORD.
DATABASE_URL=
# At least 32 random characters. TOKEN_ENCRYPTION_KEY: 64 hex characters.
BETTER_AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Comma-separated stable GitHub numeric IDs, never emails.
ADMIN_GITHUB_IDS=
WORKER_HEARTBEAT_SECONDS=120
QUEUE_STALL_SECONDS=600
DEPLOY_READY_TIMEOUT=180
LOCK_TIMEOUT=600
